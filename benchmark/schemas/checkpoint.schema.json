{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec2Game checkpoint",
  "type": "object",
  "required": ["id", "game_slug", "dimension", "item", "objective", "initial_state", "trigger", "expected_transition", "detection_method", "score_rubric"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.D2\\.[1-5]\\.[0-9]{2}$"},
    "game_slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "dimension": {"enum": ["D2.1", "D2.2", "D2.3", "D2.4", "D2.5"]},
    "item": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "initial_state": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "expected_transition": {"type": "string", "minLength": 1},
    "detection_method": {"type": "string", "minLength": 1},
    "score_rubric": {
      "type": "object",
      "required": ["0", "1", "2"],
      "properties": {"0": {"type": "string", "minLength": 1}, "1": {"type": "string", "minLength": 1}, "2": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
