{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec2Game game metadata",
  "type": "object",
  "required": ["schema_version", "slug", "name", "difficulty", "spec", "checkpoints", "variants"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "spec": {"const": "spec.md"},
    "checkpoints": {"const": "checkpoints.jsonl"},
    "variants": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_var0[1-9]$"}, "uniqueItems": true, "maxItems": 9},
    "family_slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "variant_id": {"type": "string", "pattern": "^(base|var0[1-9])$"},
    "window_size": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2}
  },
  "additionalProperties": true
}
